# حصاد جازان V1 — انسخ هذا الملف إلى .env للتطوير المحلي فقط
# في الإنتاج تُضاف هذه القيم كـ Environment Variables على CranL ولا تُرفع إلى GitHub

NODE_ENV=production
PORT=3000

# رابط الموقع النهائي بدون شرطة أخيرة، مثال: https://example.com
APP_ORIGIN=

# PostgreSQL الخاصة
DATABASE_URL=

# نص عشوائي 32 حرفًا أو أكثر
SESSION_SECRET=

# ناتج الأمر: npm run hash-password
ADMIN_PASSWORD_HASH=

# إشعارات البريد
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=hasadjaz@gmail.com

# عدد الـ proxies أمام التطبيق
TRUST_PROXY=1
